/// Measure home for two-marriages-v2. Folder taxonomy: 01 Core (the
/// handoff's data_model.md measures) / 02 Display (T1 tooltip text).
table _Measures

	/// How many HP sets in the current slice (data_model.md: era-filtered 67 / 142).
	measure 'Total Sets' = COUNTROWS ( Sets )
		formatString: #,0
		displayFolder: 01 Core

	/// Typical set size: mean of Rebrickable's per-set part count (era-filtered 267 / 731).
	measure 'Avg Parts' = AVERAGE ( Sets[num_parts] )
		formatString: #,0
		displayFolder: 01 Core

	/// Biggest single set in the slice, by part count (era-filtered 2,029 / 6,020).
	measure 'Largest Set' = MAX ( Sets[num_parts] )
		formatString: #,0
		displayFolder: 01 Core

	/// Different real brick colors across the parts in view (pseudo-colors excluded at load; era-filtered 67 / 80, Diagon Alley 55).
	measure 'Distinct Colors' = DISTINCTCOUNT ( SetColors[color_id] )
		formatString: #,0
		displayFolder: 01 Core

	/// Share of parts that are gray, black, or white by the verified name rule (era-filtered 51% / 41%).
	measure 'Grayscale %' = DIVIDE ( CALCULATE ( SUM ( SetColors[part_count] ), KEEPFILTERS ( Colors[IsGrayscale] = TRUE () ) ), SUM ( SetColors[part_count] ) )
		formatString: 0%
		displayFolder: 01 Core

	/// Catalog parts shipped per year slice: SUM of Sets[num_parts] (the handoff's hero-chart formula — deliberately NOT the v1 inventory measure).
	measure 'Parts per Year' = SUM ( Sets[num_parts] )
		formatString: #,0
		displayFolder: 01 Core

	/// Distinct minifig designs in the slice — per character this is the "22 old / 59 new" variant count. Deviation from data_model.md's COUNTROWS: at fig × set grain COUNTROWS counts appearances, not variants; recorded in 06-build.
	measure 'Minifig Variants' = DISTINCTCOUNT ( Minifigs[fig_num] )
		formatString: #,0
		displayFolder: 01 Core

	/// The whole archive, all eras: 576 distinct HP minifig designs (defined slice-independent on purpose).
	measure 'Total Minifigures' = CALCULATE ( DISTINCTCOUNT ( Minifigs[fig_num] ), REMOVEFILTERS () )
		formatString: #,0
		displayFolder: 01 Core

	/// Physical parts of the color(s) in view — the Deneb strips' and composition bars' width driver.
	measure 'Color Parts' = SUM ( SetColors[part_count] )
		formatString: #,0
		displayFolder: 01 Core

	/// T1 tooltip line 1 (prototype copy): first appearance year + skin of the hovered character/fig.
	measure 'First Appearance' =
			VAR y = MIN ( Minifigs[year] )
			VAR s = CALCULATE ( MIN ( Minifigs[skin] ), Minifigs[year] = y )
			RETURN
			IF ( NOT ISBLANK ( y ), "First appeared " & y & " · " & IF ( s = "flesh", "flesh tone", s ) )
		formatString: @
		displayFolder: 02 Display\Tooltip

	/// T1 tooltip line 2 (prototype copy): latest appearance year + skin of the hovered character/fig.
	measure 'Latest Appearance' =
			VAR y = MAX ( Minifigs[year] )
			VAR s = CALCULATE ( MIN ( Minifigs[skin] ), Minifigs[year] = y )
			RETURN
			IF ( NOT ISBLANK ( y ), "Latest " & y & " · " & IF ( s = "flesh", "flesh tone", s ) )
		formatString: @
		displayFolder: 02 Display\Tooltip

	/// T1 tooltip line 3: how many distinct fig designs the hovered character has.
	measure 'Variants Text' = FORMAT ( [Minifig Variants], "#,0" ) & " variants"
		formatString: @
		displayFolder: 02 Display\Tooltip

	/// T1 era eyebrow, uppercased (textboxes/cards have no text-transform in PBIR).
	measure 'Era Upper' = UPPER ( MAX ( Minifigs[Era] ) )
		formatString: @
		displayFolder: 02 Display\Tooltip

	/// T1 headline: the hovered character's name as a card-bindable text measure.
	measure Character = MAX ( Minifigs[character_name] )
		formatString: @
		displayFolder: 02 Display\Tooltip

	column Value
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Value

	partition _Measures = m
		mode: import
		source =
				let
				    Source = #table(type table [Value = text], {})
				in
				    Source
