/// One row per Rebrickable color. Hex feeds every true-hex Deneb mark;
/// IsGrayscale implements the name rule (gray/grey/black/white) the v1
/// metric contract verified; pseudo-colors ([Unknown] -1, [No Color] 9999)
/// are flagged here and excluded from SetColors at load.
table Colors

	column color_id
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: color_id

	column 'Color Name'
		dataType: string
		summarizeBy: none
		sourceColumn: Color Name

	column Hex
		dataType: string
		summarizeBy: none
		sourceColumn: Hex

	column IsGrayscale
		dataType: boolean
		summarizeBy: none
		sourceColumn: IsGrayscale

	column IsPseudoColor
		dataType: boolean
		isHidden
		summarizeBy: none
		sourceColumn: IsPseudoColor

	partition Colors = m
		mode: import
		source =
				let
				    // Reference only (RawColors) — uniform firewall-safe pattern.
				    Source = RawColors,
				    Typed = Table.TransformColumnTypes(Source, {{"id", Int64.Type}, {"name", type text}, {"rgb", type text}, {"is_trans", type logical}}),
				    WithHex = Table.AddColumn(Typed, "Hex", each "#" & [rgb], type text),
				    WithGray = Table.AddColumn(WithHex, "IsGrayscale", each
				        let n = Text.Lower([name])
				        in Text.Contains(n, "gray") or Text.Contains(n, "grey") or Text.Contains(n, "black") or Text.Contains(n, "white"), type logical),
				    WithPseudo = Table.AddColumn(WithGray, "IsPseudoColor", each [id] = -1 or [id] = 9999, type logical),
				    Renamed = Table.RenameColumns(WithPseudo, {{"id", "color_id"}, {"name", "Color Name"}}),
				    Slim = Table.SelectColumns(Renamed, {"color_id", "Color Name", "Hex", "IsGrayscale", "IsPseudoColor"})
				in
				    Slim
