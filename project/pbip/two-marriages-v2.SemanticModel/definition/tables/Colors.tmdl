/// One row per Rebrickable color. Hex feeds every true-hex Deneb mark;
/// IsGrayscale implements the name rule (gray/grey/black/white) the v1
/// metric contract verified; pseudo-colors ([Unknown] -1, [No Color] 9999)
/// are flagged here and excluded from SetColors at load.
table Colors

	column color_id
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: color_id

	column 'Color Name'
		dataType: string
		summarizeBy: none
		sourceColumn: Color Name

	column Hex
		dataType: string
		summarizeBy: none
		sourceColumn: Hex

	column IsGrayscale
		dataType: boolean
		summarizeBy: none
		sourceColumn: IsGrayscale

	column IsPseudoColor
		dataType: boolean
		isHidden
		summarizeBy: none
		sourceColumn: IsPseudoColor

	column Luminance
		dataType: double
		isHidden
		formatString: 0.0
		summarizeBy: none
		sourceColumn: Luminance

	partition Colors = m
		mode: import
		source =
				let
				    // Reference only (RawColors) — uniform firewall-safe pattern.
				    Source = RawColors,
				    Typed = Table.TransformColumnTypes(Source, {{"id", Int64.Type}, {"name", type text}, {"rgb", type text}, {"is_trans", type logical}}),
				    WithHex = Table.AddColumn(Typed, "Hex", each "#" & [rgb], type text),
				    WithGray = Table.AddColumn(WithHex, "IsGrayscale", each
				        let n = Text.Lower([name])
				        in Text.Contains(n, "gray") or Text.Contains(n, "grey") or Text.Contains(n, "black") or Text.Contains(n, "white"), type logical),
				    WithPseudo = Table.AddColumn(WithGray, "IsPseudoColor", each [id] = -1 or [id] = 9999, type logical),
				    // Perceptual luminance from the hex; sort key for the palette strips
				    // (grayscale dark->light first, then colors dark->light).
				    hexVal = (h as text) as number =>
				        let d = (c as text) as number => Text.PositionOf("0123456789ABCDEF", Text.Upper(c))
				        in d(Text.At(h, 0)) * 16 + d(Text.At(h, 1)),
				    WithLum = Table.AddColumn(WithPseudo, "Luminance", each
				        let r = hexVal(Text.Range([rgb], 0, 2)), g = hexVal(Text.Range([rgb], 2, 2)), b = hexVal(Text.Range([rgb], 4, 2))
				        in 0.299 * r + 0.587 * g + 0.114 * b, type number),
				    Renamed = Table.RenameColumns(WithLum, {{"id", "color_id"}, {"name", "Color Name"}}),
				    Slim = Table.SelectColumns(Renamed, {"color_id", "Color Name", "Hex", "IsGrayscale", "IsPseudoColor", "Luminance"})
				in
				    Slim
