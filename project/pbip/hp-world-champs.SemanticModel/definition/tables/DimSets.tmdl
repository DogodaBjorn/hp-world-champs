/// One row per LEGO set (full universe — ranking needs all themes).
table DimSets

	column set_num
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: set_num

	column 'Set Name'
		dataType: string
		summarizeBy: none
		sourceColumn: Set Name

	column year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: year

	column num_parts
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: num_parts

	column 'Root Theme'
		dataType: string
		summarizeBy: none
		sourceColumn: Root Theme

	column 'Sub Theme'
		dataType: string
		summarizeBy: none
		sourceColumn: Sub Theme

	column Era
		dataType: string
		summarizeBy: none
		sourceColumn: Era
		sortByColumn: EraSort

	column EraSort
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: EraSort

	column img_url
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: img_url
		dataCategory: ImageUrl

	partition DimSets = m
		mode: import
		source =
				let
				    // References only (RawSets + ThemesResolved) — direct file access here
				    // plus a query reference trips the Formula.Firewall.
				    Source = RawSets,
				    Typed = Table.TransformColumnTypes(Source, {{"set_num", type text}, {"name", type text}, {"year", Int64.Type}, {"theme_id", Int64.Type}, {"num_parts", Int64.Type}, {"img_url", type text}}),
				    MergedThemes = Table.NestedJoin(Typed, {"theme_id"}, ThemesResolved, {"id"}, "T", JoinKind.LeftOuter),
				    Expanded = Table.ExpandTableColumn(MergedThemes, "T", {"Root Theme", "Sub Theme"}),
				    WithEra = Table.AddColumn(Expanded, "Era", each
				        if [Root Theme] <> "Harry Potter" then "n/a"
				        else if [year] <= 2011 then "First marriage (2001–2011)"
				        else if [year] >= 2018 then "Second marriage (2018– )"
				        else "Hiatus", type text),
				    WithEraSort = Table.AddColumn(WithEra, "EraSort", each
				        if [Era] = "First marriage (2001–2011)" then 1
				        else if [Era] = "Hiatus" then 2
				        else if [Era] = "Second marriage (2018– )" then 3
				        else 4, Int64.Type),
				    Renamed = Table.RenameColumns(WithEraSort, {{"name", "Set Name"}}),
				    Removed = Table.RemoveColumns(Renamed, {"theme_id"})
				in
				    Removed
