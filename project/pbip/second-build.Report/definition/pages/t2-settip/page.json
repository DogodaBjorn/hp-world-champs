  "name": "t2-settip",
  "displayName": "Set tooltip",
  "displayOption": "FitToPage",
  "height": 320,
  "width": 440,
  "type": "Tooltip",
  "visibility": "HiddenInViewMode",
  "objects": {
    "background": [
      {
        "properties": {
          "color": {
            "solid": {
              "color": {
                "expr": {
                  "Literal": {
                    "Value": "'#F5EFE3'"
                  }
                }
              }
            }
          },
          "transparency": {
            "expr": {
              "Literal": {
                "Value": "0D"
              }
            }
          }
        }
      }
    ]
  }
}