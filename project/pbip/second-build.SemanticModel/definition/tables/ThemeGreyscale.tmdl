/// SCENARIO CONTEXT (disconnected): brick-colour composition per LEGO theme,
/// for the dark chamber's Star Wars vs Harry Potter greyscale comparison.
/// Built from the all-theme raw CSVs (references only — firewall-safe, like
/// SetColors), curated to a few themes and filtered early. No relationships:
/// it sits outside the HP-only star schema and disturbs no other page.
/// Grain: one row per (Root Theme x greyscale flag), part_count = physical parts.
table ThemeGreyscale
	lineageTag: c0ad16c9-b022-4b9c-8c8e-f9c5bc5c7e0e

	column 'Root Theme'
		dataType: string
		lineageTag: 3018ee54-e471-4354-b1f6-fd3579c78418
		summarizeBy: none
		sourceColumn: Root Theme

	column 'Is Grayscale'
		dataType: boolean
		isHidden
		lineageTag: c9accca6-154f-4695-8b94-b9080a867916
		summarizeBy: none
		sourceColumn: IsGrayscale

	column 'Brick Type'
		dataType: string
		lineageTag: 511f070e-a0ca-4335-8564-b8ecf69e2ef5
		summarizeBy: none
		sourceColumn: Brick Type

	column part_count
		dataType: int64
		formatString: #,0
		lineageTag: 22d96389-23f0-4013-b686-3d43e24a388c
		summarizeBy: sum
		sourceColumn: part_count

	partition ThemeGreyscale = m
		mode: import
		source =
				let
				    // References only (RawSets + ThemesResolved + V1Inventories +
				    // RawInventoryParts + Colors) — the SetColors firewall-safe pattern.
				    Themes = {"Star Wars", "Harry Potter", "Friends", "City"},
				    SetsTyped = Table.TransformColumnTypes(RawSets, {{"set_num", type text}, {"theme_id", Int64.Type}}),
				    WithTheme = Table.NestedJoin(SetsTyped, {"theme_id"}, ThemesResolved, {"id"}, "T", JoinKind.LeftOuter),
				    WithRoot = Table.ExpandTableColumn(WithTheme, "T", {"Root Theme"}),
				    Curated = Table.SelectRows(WithRoot, each List.Contains(Themes, [Root Theme])),
				    SetTheme = Table.SelectColumns(Curated, {"set_num", "Root Theme"}),
				    InvJoin = Table.NestedJoin(V1Inventories, {"set_num"}, SetTheme, {"set_num"}, "st", JoinKind.Inner),
				    InvTheme = Table.ExpandTableColumn(InvJoin, "st", {"Root Theme"}),
				    PartsTyped = Table.TransformColumnTypes(RawInventoryParts, {{"inventory_id", Int64.Type}, {"color_id", Int64.Type}, {"quantity", Int64.Type}, {"is_spare", type logical}}),
				    NoSpares = Table.SelectRows(PartsTyped, each not [is_spare]),
				    PartsInScope = Table.NestedJoin(NoSpares, {"inventory_id"}, InvTheme, {"inventory_id"}, "inv", JoinKind.Inner),
				    WithThemeCol = Table.ExpandTableColumn(PartsInScope, "inv", {"Root Theme"}),
				    WithColor = Table.NestedJoin(WithThemeCol, {"color_id"}, Colors, {"color_id"}, "c", JoinKind.Inner),
				    WithGray = Table.ExpandTableColumn(WithColor, "c", {"IsGrayscale", "IsPseudoColor"}),
				    RealColors = Table.SelectRows(WithGray, each not [IsPseudoColor]),
				    Grouped = Table.Group(RealColors, {"Root Theme", "IsGrayscale"}, {{"part_count", each List.Sum([quantity]), Int64.Type}}),
				    Labeled = Table.AddColumn(Grouped, "Brick Type", each if [IsGrayscale] then "Grey" else "Colour", type text)
				in
				    Labeled

