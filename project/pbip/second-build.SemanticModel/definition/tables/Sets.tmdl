/// One row per LEGO Harry Potter set, 2001–2026 (root theme "Harry Potter"
/// via ThemesResolved). Era and Size Bin are the handoff's calculated
/// columns (data_model.md): era splits the two builds around the
/// 2012–2017 silence; size_bin drives the S2/S3 distribution charts.
table Sets

	column set_num
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: set_num

	column 'Set Name'
		dataType: string
		summarizeBy: none
		sourceColumn: Set Name

	column year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: year

	column num_parts
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: num_parts

	/// Unique display label per set (names repeat across years - 'Hogwarts Castle' x3);
	/// the explorer bar's category so a click selects exactly one set.
	column 'Set Label' = Sets[Set Name] & " · " & Sets[year]
		dataType: string
		summarizeBy: none

	column Era
		dataType: string
		summarizeBy: none
		sourceColumn: Era
		sortByColumn: EraSort

	column EraSort
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: EraSort

	column 'Size Bin'
		dataType: string
		summarizeBy: none
		sourceColumn: Size Bin
		sortByColumn: SizeBinSort

	column SizeBinSort
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: SizeBinSort

	column img_url
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: img_url
		dataCategory: ImageUrl

	partition Sets = m
		mode: import
		source =
				let
				    // References only (RawSets + ThemesResolved) — direct file access here
				    // plus a query reference trips the Formula.Firewall.
				    Source = RawSets,
				    Typed = Table.TransformColumnTypes(Source, {{"set_num", type text}, {"name", type text}, {"year", Int64.Type}, {"theme_id", Int64.Type}, {"num_parts", Int64.Type}, {"img_url", type text}}),
				    MergedThemes = Table.NestedJoin(Typed, {"theme_id"}, ThemesResolved, {"id"}, "T", JoinKind.LeftOuter),
				    Expanded = Table.ExpandTableColumn(MergedThemes, "T", {"Root Theme"}),
				    HPOnly = Table.SelectRows(Expanded, each [Root Theme] = "Harry Potter" and [year] >= 2001 and [year] <= 2026),
				    WithEra = Table.AddColumn(HPOnly, "Era", each
				        if [year] <= 2011 then "First Build"
				        else if [year] >= 2018 then "Second Build"
				        else "Silence", type text),
				    WithEraSort = Table.AddColumn(WithEra, "EraSort", each
				        if [Era] = "First Build" then 1
				        else if [Era] = "Silence" then 2
				        else 3, Int64.Type),
				    WithBin = Table.AddColumn(WithEraSort, "Size Bin", each
				        if [num_parts] <= 100 then "1–100"
				        else if [num_parts] <= 300 then "101–300"
				        else if [num_parts] <= 700 then "301–700"
				        else if [num_parts] <= 2000 then "701–2k"
				        else "2k+", type text),
				    WithBinSort = Table.AddColumn(WithBin, "SizeBinSort", each
				        if [num_parts] <= 100 then 1
				        else if [num_parts] <= 300 then 2
				        else if [num_parts] <= 700 then 3
				        else if [num_parts] <= 2000 then 4
				        else 5, Int64.Type),
				    Renamed = Table.RenameColumns(WithBinSort, {{"name", "Set Name"}}),
				    Removed = Table.RemoveColumns(Renamed, {"theme_id", "Root Theme"})
				in
				    Removed
