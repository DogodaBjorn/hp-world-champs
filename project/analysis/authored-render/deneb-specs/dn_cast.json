{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chapter IV - The Cast Assembles. One dot per HP minifig design (fig_num). x = first appearance year (jittered), y = number of sets it appears in (jittered), colour = classic-yellow (<=2003) vs modern-flesh era, size = appearances. Dataset: fig_num, Minifig Name, Fig First Year, Fig Appearances.",
  "width": "container",
  "height": "container",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": "transparent",
  "data": {
    "name": "dataset"
  },
  "transform": [
    {
      "filter": "isValid(datum['Fig First Year']) && isValid(datum['Fig Appearances']) && datum['Fig Appearances'] > 0"
    },
    {
      "calculate": "datum['Fig First Year'] <= 2003 ? 'Classic yellow' : 'Modern flesh'",
      "as": "Era"
    },
    {
      "calculate": "datum['Fig First Year'] + (random()-0.5)*0.72",
      "as": "jx"
    },
    {
      "calculate": "datum['Fig Appearances'] + (random()-0.5)*0.5",
      "as": "jy"
    }
  ],
  "mark": {
    "type": "circle",
    "opacity": 0.8,
    "stroke": "#3A2A14",
    "strokeWidth": 0.4
  },
  "encoding": {
    "x": {
      "field": "jx",
      "type": "quantitative",
      "scale": {
        "domain": [
          2000,
          2026
        ],
        "nice": false
      },
      "axis": {
        "title": "First appearance year",
        "format": "d",
        "values": [
          2001,
          2004,
          2007,
          2010,
          2013,
          2016,
          2019,
          2022,
          2025
        ],
        "labelColor": "#211B14",
        "labelFont": "Candara",
        "labelFontSize": 11,
        "titleColor": "#3A2A14",
        "titleFont": "Candara",
        "titleFontSize": 12,
        "titleFontWeight": "bold",
        "grid": false,
        "domainColor": "#8A7A5B",
        "tickColor": "#8A7A5B",
        "labelFlush": true
      }
    },
    "y": {
      "field": "jy",
      "type": "quantitative",
      "scale": {
        "nice": true,
        "zero": true
      },
      "axis": {
        "title": "Sets it appears in",
        "labelColor": "#211B14",
        "labelFont": "Candara",
        "labelFontSize": 11,
        "titleColor": "#3A2A14",
        "titleFont": "Candara",
        "titleFontSize": 12,
        "titleFontWeight": "bold",
        "gridColor": "#E1D6BE",
        "gridOpacity": 0.7,
        "domain": false,
        "tickColor": "#8A7A5B",
        "tickCount": 6
      }
    },
    "size": {
      "field": "Fig Appearances",
      "type": "quantitative",
      "scale": {
        "range": [
          22,
          340
        ]
      },
      "legend": null
    },
    "color": {
      "field": "Era",
      "type": "nominal",
      "scale": {
        "domain": [
          "Classic yellow",
          "Modern flesh"
        ],
        "range": [
          "#E3B23C",
          "#C98A5B"
        ]
      },
      "legend": {
        "title": null,
        "orient": "top-right",
        "direction": "horizontal",
        "labelColor": "#3A2A14",
        "labelFont": "Candara",
        "labelFontSize": 12,
        "symbolType": "circle",
        "symbolSize": 110,
        "offset": 4
      }
    },
    "tooltip": [
      {
        "field": "Minifig Name",
        "type": "nominal",
        "title": "Minifig"
      },
      {
        "field": "Fig First Year",
        "type": "quantitative",
        "title": "First appeared",
        "format": "d"
      },
      {
        "field": "Fig Appearances",
        "type": "quantitative",
        "title": "Appears in",
        "format": "d"
      }
    ]
  }
}